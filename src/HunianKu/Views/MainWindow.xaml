<Window x:Class="HunianKu.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HunianKu - Sistem Manajemen Apartemen" Height="780" Width="1360" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="pack://application:,,,/HunianKu;component/Assets/hunianku.ico" Background="{StaticResource Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <DockPanel Background="{StaticResource Sidebar}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,18">
                <Image Source="pack://application:,,,/HunianKu;component/Assets/hunianku.png" Width="34" Height="34"/>
                <TextBlock Text="HunianKu" Foreground="White" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource SidebarHover}" CornerRadius="8"
                    Margin="14,0,14,14" Padding="12,10">
                <StackPanel>
                    <TextBlock x:Name="TxtNamaUser" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtRoleUser" Foreground="#9FB3C8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Button DockPanel.Dock="Bottom" Style="{StaticResource MenuButton}" Margin="8,4,8,16" Click="Logout_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#F87171" Width="26" VerticalAlignment="Center"/>
                    <TextBlock Text="Keluar" Foreground="#F87171"/>
                </StackPanel>
            </Button>

            <!-- Tombol menu diisi dari kode sesuai role user -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelMenu"/>
            </ScrollViewer>
        </DockPanel>

        <!-- ===== Area konten ===== -->
        <DockPanel Grid.Column="1" Margin="24,18,24,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTanggal" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtJudulHalaman" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <ContentControl x:Name="Konten"/>
        </DockPanel>
    </Grid>
</Window>
