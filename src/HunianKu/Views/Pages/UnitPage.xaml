<UserControl x:Class="HunianKu.Views.Pages.UnitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Daftar Unit" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="CmbFilterTower" Width="190" DisplayMemberPath="Tampilan"
                                  SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="CmbFilterStatus" Width="150" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="TxtJumlah" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                <DataGrid x:Name="DgUnit" SelectionChanged="DgUnit_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit" Binding="{Binding KodeUnit}" Width="90"/>
                        <DataGridTextColumn Header="Tipe" Binding="{Binding NamaTipe}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Lantai" Binding="{Binding Lantai}" Width="70"/>
                        <DataGridTextColumn Header="Harga Sewa" Binding="{Binding HargaSewaBulanan, StringFormat='Rp {0:N0}'}"
                                            Width="130" ElementStyle="{StaticResource AngkaKanan}"/>
                        <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource StatusBadge}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtJudulForm" Text="Tambah Unit" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Tower" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbTower" DisplayMemberPath="Tampilan"/>

                <TextBlock Text="Tipe Unit" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbTipe" DisplayMemberPath="NamaTipe"/>

                <TextBlock Text="Nomor Unit (contoh: 0501)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNomor" MaxLength="10" CharacterCasing="Upper"/>

                <TextBlock Text="Lantai" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtLantai" MaxLength="3"/>

                <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbStatus"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Text="Status Terisi diatur otomatis ketika kontrak dibuat, dan kembali Kosong ketika kontrak diakhiri."/>

                <WrapPanel Margin="0,20,0,0">
                    <Button Content="Simpan" Click="Simpan_Click"/>
                    <Button Content="Baru" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Baru_Click"/>
                    <Button x:Name="BtnHapus" Content="Hapus" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            Click="Hapus_Click" IsEnabled="False"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
