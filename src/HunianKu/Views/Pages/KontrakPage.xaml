<UserControl x:Class="HunianKu.Views.Pages.KontrakPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Daftar Kontrak Sewa" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox x:Name="TxtCari" Width="180" KeyDown="TxtCari_KeyDown" ToolTip="Cari nama, nomor kontrak, atau unit"/>
                        <ComboBox x:Name="CmbFilterStatus" Width="130" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                           Text="Baris berwarna kuning = kontrak aktif yang akan berakhir dalam masa pengingat (lihat menu Tarif)."/>
                <DataGrid x:Name="DgKontrak" SelectionChanged="DgKontrak_SelectionChanged" LoadingRow="DgKontrak_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Kontrak" Binding="{Binding NomorKontrak}" Width="95"/>
                        <DataGridTextColumn Header="Penghuni" Binding="{Binding NamaPenghuni}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding KodeUnit}" Width="70"/>
                        <DataGridTextColumn Header="Selesai" Binding="{Binding TanggalSelesai, StringFormat=dd MMM yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Sisa Hari" Binding="{Binding SisaHariTeks}" Width="75"/>
                        <DataGridTextColumn Header="Sewa / Bulan" Binding="{Binding HargaSewaBulanan, StringFormat='Rp {0:N0}'}"
                                            Width="120" ElementStyle="{StaticResource AngkaKanan}"/>
                        <DataGridTemplateColumn Header="Status" Width="100" CellTemplate="{StaticResource StatusBadge}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <StackPanel x:Name="PanelBaru">
                        <TextBlock Text="Buat Kontrak Baru" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Penghuni (belum punya kontrak aktif)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbPenghuni" DisplayMemberPath="Tampilan"/>

                        <TextBlock Text="Unit (status Kosong)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbUnit" DisplayMemberPath="Tampilan" SelectionChanged="CmbUnit_SelectionChanged"/>

                        <TextBlock Text="Tanggal Mulai" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpMulai" SelectedDateChanged="DpMulai_Changed"/>

                        <TextBlock Text="Lama Sewa" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbLama" SelectionChanged="CmbLama_SelectionChanged"/>

                        <TextBlock Text="Tanggal Selesai" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpSelesai"/>

                        <TextBlock Text="Harga Sewa per Bulan (Rp)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtHarga"/>

                        <TextBlock Text="Deposit (Rp)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtDeposit"/>

                        <Button Content="Buat Kontrak" Margin="0,20,0,0" HorizontalAlignment="Left" Click="Buat_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelDetail" Visibility="Collapsed">
                        <TextBlock x:Name="TxtJudulDetail" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="TxtInfoDetail" TextWrapping="Wrap" LineHeight="22"/>

                        <TextBlock Text="Tanggal Selesai (ubah untuk perpanjang)" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpSelesaiEdit"/>

                        <TextBlock Text="Deposit (Rp)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtDepositEdit"/>

                        <WrapPanel Margin="0,20,0,0">
                            <Button x:Name="BtnSimpanEdit" Content="Simpan Perubahan" Click="SimpanEdit_Click" Margin="0,0,8,8"/>
                            <Button x:Name="BtnAkhiri" Content="Akhiri Kontrak" Style="{StaticResource SecondaryButton}"
                                    Click="Akhiri_Click" Margin="0,0,8,8"/>
                            <Button x:Name="BtnBatalkan" Content="Batalkan" Style="{StaticResource DangerButton}"
                                    Click="Batalkan_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Button Content="+ Buat Kontrak Baru" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="Baru_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
