<UserControl x:Class="HunianKu.Views.Pages.GantiPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Ganti Password" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Text="Password disimpan dalam bentuk hash (PBKDF2-SHA256), sehingga tidak ada yang bisa melihat password asli Anda, termasuk admin."/>

            <TextBlock Text="Password Lama" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtLama"/>

            <TextBlock Text="Password Baru (min. 6 karakter)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtBaru"/>

            <TextBlock Text="Ulangi Password Baru" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtKonfirmasi"/>

            <Button Content="Simpan Password" Margin="0,20,0,0" HorizontalAlignment="Left" Click="Simpan_Click"/>
        </StackPanel>
    </Border>
</UserControl>
