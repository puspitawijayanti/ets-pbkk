<UserControl x:Class="HunianKu.Views.Pages.VerifikasiPembayaranPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Pembayaran Penghuni" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbStatus" Width="150" HorizontalAlignment="Right" SelectionChanged="CmbStatus_SelectionChanged"/>
                </DockPanel>
                <DataGrid x:Name="DgPembayaran" SelectionChanged="DgPembayaran_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tgl Bayar" Binding="{Binding TanggalBayar, StringFormat=dd MMM yyyy}" Width="95"/>
                        <DataGridTextColumn Header="No. Tagihan" Binding="{Binding NomorTagihan}" Width="130"/>
                        <DataGridTextColumn Header="Penghuni" Binding="{Binding NamaPenghuni}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding KodeUnit}" Width="65"/>
                        <DataGridTextColumn Header="Jumlah" Binding="{Binding JumlahBayar, StringFormat='Rp {0:N0}'}" Width="115" ElementStyle="{StaticResource AngkaKanan}"/>
                        <DataGridTextColumn Header="Metode" Binding="{Binding MetodeBayar}" Width="75"/>
                        <DataGridTemplateColumn Header="Status" Width="95" CellTemplate="{StaticResource StatusBadge}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Detail Pembayaran" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TxtDetail" Text="Pilih pembayaran di tabel." TextWrapping="Wrap" LineHeight="22"/>

                <TextBlock Text="Catatan (wajib jika ditolak)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtCatatan" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" MaxLength="250"/>

                <WrapPanel Margin="0,18,0,0">
                    <Button x:Name="BtnTerima" Content="Terima (Lunas)" Style="{StaticResource SuccessButton}"
                            Click="Terima_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="BtnTolak" Content="Tolak" Style="{StaticResource DangerButton}"
                            Click="Tolak_Click" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                           Text="Diterima: tagihan menjadi Lunas. Ditolak: tagihan kembali Belum Bayar dan denda berjalan lagi."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>