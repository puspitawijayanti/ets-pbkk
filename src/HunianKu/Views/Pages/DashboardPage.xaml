<UserControl x:Class="HunianKu.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <WrapPanel x:Name="PanelKartu" DockPanel.Dock="Top"/>


        <Border x:Name="BannerInfo" DockPanel.Dock="Top" Background="{StaticResource WarningSoft}" BorderBrush="#F59E0B"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,12,12" Visibility="Collapsed">
            <TextBlock x:Name="TxtBanner" TextWrapping="Wrap" Foreground="#92400E"/>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock x:Name="TxtJudulTabel" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TxtTabelKosong" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                <Grid>

                    <DataGrid x:Name="DgKontrak" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No. Kontrak" Binding="{Binding NomorKontrak}" Width="110"/>
                            <DataGridTextColumn Header="Penghuni" Binding="{Binding NamaPenghuni}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="No. HP" Binding="{Binding NoHp}" Width="130"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding KodeUnit}" Width="80"/>
                            <DataGridTextColumn Header="Berakhir" Binding="{Binding TanggalSelesai, StringFormat=dd MMMM yyyy}" Width="150"/>
                            <DataGridTextColumn Header="Sisa Hari" Binding="{Binding SisaHari}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>


                    <DataGrid x:Name="DgKomplain" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tiket" Binding="{Binding NomorTiket}" Width="100"/>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalAjukan, StringFormat=dd MMM yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding KodeUnit}" Width="80"/>
                            <DataGridTextColumn Header="Penghuni" Binding="{Binding NamaPenghuni}" Width="160"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="100"/>
                            <DataGridTextColumn Header="Judul" Binding="{Binding Judul}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Prioritas" Binding="{Binding Prioritas}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="DgTagihan" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No. Tagihan" Binding="{Binding NomorTagihan}" Width="140"/>
                            <DataGridTextColumn Header="Periode" Binding="{Binding PeriodeTeks}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Jatuh Tempo" Binding="{Binding TanggalJatuhTempo, StringFormat=dd MMM yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Harus Dibayar" Binding="{Binding GrandTotal, StringFormat='Rp {0:N0}'}" Width="140"
                                                ElementStyle="{StaticResource AngkaKanan}"/>
                            <DataGridTemplateColumn Header="Status" Width="160" CellTemplate="{StaticResource StatusBadge}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
