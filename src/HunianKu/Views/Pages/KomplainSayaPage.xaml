<UserControl x:Class="HunianKu.Views.Pages.KomplainSayaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Komplain Saya" Style="{StaticResource SectionTitle}"/>
                <DataGrid x:Name="DgKomplain" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tiket" Binding="{Binding NomorTiket}" Width="85"/>
                        <DataGridTextColumn Header="Diajukan" Binding="{Binding TanggalAjukan, StringFormat=dd MMM yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Judul" Binding="{Binding Judul}" Width="*" MinWidth="140"/>
                        <DataGridTemplateColumn Header="Status" Width="90" CellTemplate="{StaticResource StatusBadge}"/>
                        <DataGridTextColumn Header="Teknisi" Binding="{Binding NamaTeknisi, TargetNullValue='-'}" Width="120"/>
                        <DataGridTextColumn Header="Catatan Penanganan" Binding="{Binding CatatanPenanganan}" Width="1.3*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Ajukan Komplain Baru" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TxtUnit" Style="{StaticResource MutedText}"/>

                <TextBlock Text="Kategori" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbKategori"/>

                <TextBlock Text="Prioritas" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbPrioritas"/>

                <TextBlock Text="Judul Singkat" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtJudul" MaxLength="100"/>

                <TextBlock Text="Deskripsi Masalah" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtDeskripsi" Height="110" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" MaxLength="1000"/>

                <Button x:Name="BtnKirim" Content="Kirim Komplain" Margin="0,18,0,0" HorizontalAlignment="Left" Click="Kirim_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
