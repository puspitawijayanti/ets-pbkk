<UserControl x:Class="HunianKu.Views.Pages.TipeUnitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Daftar Tipe Unit" Style="{StaticResource SectionTitle}"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                           Text="Harga sewa di sini adalah harga standar. Harga di kontrak yang sudah dibuat tidak ikut berubah."/>
                <DataGrid x:Name="DgTipe" SelectionChanged="DgTipe_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama Tipe" Binding="{Binding NamaTipe}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Luas (m²)" Binding="{Binding LuasM2, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="Kamar" Binding="{Binding JumlahKamar}" Width="70"/>
                        <DataGridTextColumn Header="Sewa / Bulan" Binding="{Binding HargaSewaBulanan, StringFormat='Rp {0:N0}'}"
                                            Width="140" ElementStyle="{StaticResource AngkaKanan}"/>
                        <DataGridTextColumn Header="IPL / Bulan" Binding="{Binding IplPerBulan, StringFormat='Rp {0:N0}'}"
                                            Width="120" ElementStyle="{StaticResource AngkaKanan}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtJudulForm" Text="Tambah Tipe Unit" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Nama Tipe" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNama" MaxLength="50"/>

                <TextBlock Text="Luas (m²)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtLuas"/>

                <TextBlock Text="Jumlah Kamar Tidur" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtKamar" MaxLength="2"/>

                <TextBlock Text="Harga Sewa per Bulan (Rp)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtHarga"/>

                <TextBlock Text="IPL / Service Charge per Bulan (Rp)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtIpl"/>

                <WrapPanel Margin="0,20,0,0">
                    <Button Content="Simpan" Click="Simpan_Click"/>
                    <Button Content="Baru" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Baru_Click"/>
                    <Button x:Name="BtnHapus" Content="Hapus" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            Click="Hapus_Click" IsEnabled="False"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
