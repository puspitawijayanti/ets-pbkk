<UserControl x:Class="HunianKu.Views.Pages.TarifPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Pengaturan Tarif" Style="{StaticResource SectionTitle}"/>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource PrimarySoft}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12.5">
                        <Run FontWeight="SemiBold" Text="Rumus tagihan bulanan"/><LineBreak/>
                        <Run Text="Total = Sewa (dari kontrak) + (pemakaian kWh × tarif listrik) + (pemakaian m³ × tarif air) + IPL (dari tipe unit)."/><LineBreak/>
                        <Run Text="Jatuh tempo = tanggal yang diatur di sini pada bulan berikutnya."/><LineBreak/>
                        <Run Text="Denda = jumlah hari terlambat × denda per hari (dihitung otomatis setiap data tagihan dibuka)."/><LineBreak/>
                        <Run FontStyle="Italic" Text="Perubahan tarif hanya berlaku untuk tagihan yang dibuat setelahnya."/>
                    </TextBlock>
                </Border>
                <DataGrid x:Name="DgTarif" SelectionChanged="DgTarif_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding NamaTarif}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai, StringFormat={}{0:N0}}" Width="110"
                                            ElementStyle="{StaticResource AngkaKanan}"/>
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="90"/>
                        <DataGridTextColumn Header="Terakhir Diubah" Binding="{Binding DiubahPada, StringFormat=dd MMM yyyy HH:mm}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Ubah Tarif" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TxtNamaTarif" Text="Pilih tarif di tabel." Style="{StaticResource MutedText}"/>
                <TextBlock x:Name="LblNilai" Text="Nilai Baru" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNilai"/>
                <Button x:Name="BtnSimpan" Content="Simpan" Margin="0,20,0,0" HorizontalAlignment="Left"
                        Click="Simpan_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>