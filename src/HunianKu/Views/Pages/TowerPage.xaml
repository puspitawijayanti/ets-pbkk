<UserControl x:Class="HunianKu.Views.Pages.TowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Daftar Tower" Style="{StaticResource SectionTitle}"/>
                <DataGrid x:Name="DgTower" SelectionChanged="DgTower_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding KodeTower}" Width="70"/>
                        <DataGridTextColumn Header="Nama Tower" Binding="{Binding NamaTower}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="2*" MinWidth="140"/>
                        <DataGridTextColumn Header="Lantai" Binding="{Binding JumlahLantai}" Width="70"/>
                        <DataGridTextColumn Header="Jumlah Unit" Binding="{Binding JumlahUnit}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>


        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtJudulForm" Text="Tambah Tower" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Kode Tower (maks. 5 karakter)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtKode" MaxLength="5" CharacterCasing="Upper"/>

                <TextBlock Text="Nama Tower" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNama" MaxLength="100"/>

                <TextBlock Text="Alamat" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtAlamat" MaxLength="200" TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                         VerticalContentAlignment="Top"/>

                <TextBlock Text="Jumlah Lantai" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtLantai" MaxLength="3"/>

                <WrapPanel Margin="0,20,0,0">
                    <Button Content="Simpan" Click="Simpan_Click"/>
                    <Button Content="Baru" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Baru_Click"/>
                    <Button x:Name="BtnHapus" Content="Hapus" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            Click="Hapus_Click" IsEnabled="False"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
