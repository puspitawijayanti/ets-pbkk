<UserControl x:Class="HunianKu.Views.Pages.TagihanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Periode" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbBulan" Width="120"/>
                <ComboBox x:Name="CmbTahun" Width="80" Margin="6,0,0,0"/>
                <CheckBox x:Name="ChkSemuaPeriode" Content="Semua periode" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Status" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <ComboBox x:Name="CmbStatus" Width="170"/>
                <TextBox x:Name="TxtCari" Width="170" Margin="12,0,0,0" ToolTip="Cari nama, unit, atau nomor tagihan"/>
                <Button Content="Tampilkan" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Tampilkan_Click"/>
                <Button Content="Generate Tagihan Periode Ini" Margin="8,0,0,0" Click="Generate_Click"
                        ToolTip="Buat tagihan untuk semua kontrak yang meterannya sudah diinput pada periode terpilih"/>
            </WrapPanel>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource PrimarySoft}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                <TextBlock x:Name="TxtRingkasan" FontWeight="SemiBold"/>
            </Border>

            <DataGrid x:Name="DgTagihan">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No. Tagihan" Binding="{Binding NomorTagihan}" Width="135"/>
                    <DataGridTextColumn Header="Penghuni" Binding="{Binding NamaPenghuni}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding KodeUnit}" Width="70"/>
                    <DataGridTextColumn Header="Periode" Binding="{Binding PeriodeTeks}" Width="120"/>
                    <DataGridTextColumn Header="Jatuh Tempo" Binding="{Binding TanggalJatuhTempo, StringFormat=dd MMM yyyy}" Width="105"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalTagihan, StringFormat='Rp {0:N0}'}" Width="120"
                                        ElementStyle="{StaticResource AngkaKanan}"/>
                    <DataGridTextColumn Header="Denda" Binding="{Binding Denda, StringFormat='Rp {0:N0}'}" Width="100"
                                        ElementStyle="{StaticResource AngkaKanan}"/>
                    <DataGridTextColumn Header="Harus Dibayar" Binding="{Binding GrandTotal, StringFormat='Rp {0:N0}'}" Width="125"
                                        ElementStyle="{StaticResource AngkaKanan}"/>
                    <DataGridTemplateColumn Header="Status" Width="150" CellTemplate="{StaticResource StatusBadge}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
